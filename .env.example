# RefGuard environment (copy to .env)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: API keys for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=<REDACTED_EMAIL>

# LLM (optional, for relevance check)
DASHSCOPE_API_KEY=<REDACTED_DASHSCOPE_API_KEY>

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# No telemetry by default
REFGUARD_TELEMETRY=false
