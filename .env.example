# RefGuard environment template. Copy to .env and fill only the values you need.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: API keys for higher rate limits. Leave blank for anonymous access.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Optional LLM relevance checks are disabled by default.
# Never commit real API keys.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# No telemetry by default
REFGUARD_TELEMETRY=false
